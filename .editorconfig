root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
# Prettier formats with tabs (prettier.config.js: useTabs).
indent_style = tab
indent_size = 2

# YAML forbids tabs; Markdown lists and code blocks read better with spaces.
[*.{yml,yaml,md}]
indent_style = space
indent_size = 2
