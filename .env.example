# Copy to .env for local development. Every variable is declared in src/env.ts (OPS-01);
# an invalid value stops the start, listing each variable by name.

# frappe-api (src/lib/server/config/frappe-api.env.ts)
# Required. frappe-api base URL: 8080 is `just stack up` in frappe-api, 5080 is `just run api` there.
FRAPPE_API_BASE_URL=http://localhost:8080
# Optional. One attempt, in ms (100-30000). Default 3000.
# FRAPPE_API_ATTEMPT_TIMEOUT_MS=3000
# Optional. Whole call including its retry, in ms (100-60000). Default 8000.
# Must be at least 2 x FRAPPE_API_ATTEMPT_TIMEOUT_MS + 1000, checked at start (OPS-02).
# FRAPPE_API_TOTAL_TIMEOUT_MS=8000

# Session (src/lib/server/config/session.env.ts)
# Optional. Session cookie name; must start with __Host-. Default __Host-workspace-sid.
# SESSION_COOKIE_NAME=__Host-workspace-sid
# Required. The BFF's own Valkey (redis://, rediss://, valkey:// or valkeys://). `just infra up` serves it on 6380.
VALKEY_URL=redis://localhost:6380/0
