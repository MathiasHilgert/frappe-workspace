# The local stack (deploy/compose.yaml). Optional: copy to deploy/.env only to change a default.
# Compose reads deploy/.env on its own; the app's own variables for `bun run dev` live in the root .env.

# Host port of the workspace image, on the loopback (http://localhost:4000).
# WORKSPACE_PORT=4000

# Host port of the workspace's Valkey, on the loopback. 6380 leaves 6379 to frappe-api's Valkey.
# WORKSPACE_VALKEY_PORT=6380

# frappe-api as seen from inside the workspace container. The default is frappe-api's own stack on the host
# (`just stack up` in frappe-api publishes it on 8080).
# WORKSPACE_FRAPPE_API_URL=http://host.docker.internal:8080
