{
	"name": "frappe-workspace",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --max-warnings 0 && markdownlint-cli2 --config eng/markdownlint-cli2.jsonc",
		"arch": "depcruise src --config eng/dependency-cruiser.cjs",
		"deadcode": "knip --config eng/knip.jsonc",
		"gate": "bun run check && bun run lint && bun run arch && bun run deadcode && bun run test:unit --run",
		"format": "prettier --write .",
		"audit": "bun eng/scripts/audit.mjs",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage.enabled --coverage.reportsDirectory=.svelte-kit/coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcov '--coverage.include=src/**/*.{ts,svelte}' '--coverage.exclude=**/*.d.ts' '--coverage.exclude=**/*.test.ts' '--coverage.exclude=src/lib/paraglide/**' '--coverage.exclude=src/lib/shared/ui/primitives/**'",
		"test:scripts": "node --test eng/scripts/*.test.mjs",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "playwright test --config tests/playwright.config.ts --pass-with-no-tests"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.6.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "~3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "4.1.12",
		"@vitest/eslint-plugin": "1.6.28",
		"dependency-cruiser": "^18.7.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"eslint-plugin-jsdoc": "^65.4.9",
		"eslint-plugin-playwright": "2.12.2",
		"eslint-plugin-regexp": "3.3.3",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "6.45.1",
		"lefthook": "^2.2.2",
		"markdownlint-cli2": "^0.24.1",
		"msw": "^3.0.6",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"runed": "^0.38.0",
		"svelte": "~5.57.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
